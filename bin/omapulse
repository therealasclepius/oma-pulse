#!/usr/bin/env bash
set -euo pipefail
case "${1:-open}" in
  open|command|assistant|connections|dashboard|close|status|toggle) action="${1:-open}" ;;
  --version) echo 'Oma Pulse 0.7.0'; exit 0 ;;
  --help|-h) echo 'Usage: omapulse [open|command|assistant|connections|dashboard|close|status|toggle]'; exit 0 ;;
  *) echo 'Unknown command. Run omapulse --help.' >&2; exit 2 ;;
esac
if ! command -v omarchy-shell >/dev/null; then
  echo 'Oma Pulse requires the Omarchy desktop shell.' >&2; exit 1
fi
exec omarchy-shell omapulse "$action"

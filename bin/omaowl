#!/usr/bin/env bash
set -euo pipefail
case "${1:-open}" in
  open|command|assistant|dashboard|close|status|toggle) action="${1:-open}" ;;
  --version) echo 'Oma Owl 0.5.0'; exit 0 ;;
  --help|-h) echo 'Usage: omaowl [open|command|assistant|dashboard|close|status|toggle]'; exit 0 ;;
  *) echo 'Unknown command. Run omaowl --help.' >&2; exit 2 ;;
esac
if ! command -v omarchy-shell >/dev/null; then
  echo 'Oma Owl requires the Omarchy desktop shell.' >&2; exit 1
fi
exec omarchy-shell omaowl "$action"
